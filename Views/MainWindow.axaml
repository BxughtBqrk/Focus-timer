<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FocusTimer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="500"
        Width="{Binding WindowWidth}" Height="{Binding WindowHeight}"
        x:Class="FocusTimer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/focus-logo.png"
        Title="FocusTimer"
        Topmost="{Binding IsAlwaysOnTop}"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        MinWidth="180" MinHeight="80"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Classes.Ghost="{Binding IsGhostModeEnabled}"
        PointerPressed="Window_PointerPressed">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid Classes.Ghost="{Binding IsGhostModeEnabled}">
        <Grid.Styles>
            <Style Selector="Border.TimerRing">
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="#1E1E1E" Opacity="0.5"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style Selector="Border.AnimFade">
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                    </Transitions>
                </Setter>
            </Style>

            <Style Selector="Viewbox.AnimFade">
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                    </Transitions>
                </Setter>
            </Style>

            <Style Selector="Border.SettingsPanel">
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="RenderTransform" Value="translateY(20px)"/>
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                    </Transitions>
                </Setter>
            </Style>

            <Style Selector="Border.SettingsPanel.visible">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="IsHitTestVisible" Value="True"/>
                <Setter Property="RenderTransform" Value="translateY(0px)"/>
            </Style>
        </Grid.Styles>

        <!-- Main Dark Background -->
        <Border Classes="AnimFade" Background="#121212" Opacity="{Binding CurrentBackgroundOpacity}" IsHitTestVisible="{Binding IsNotGhostMode}"/>

        <!-- Main UI -->
        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding ShowMainMode}">
            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Height="40" Background="Transparent" Margin="10,0" IsVisible="{Binding IsNotGhostMode}">
                <Button HorizontalAlignment="Left" 
                        VerticalAlignment="Center" 
                        Content="↙" 
                        Command="{Binding ToggleMiniModeCommand}"
                        Background="Transparent"
                        Foreground="#888888"
                        BorderThickness="0"
                        FontSize="16"/>

                <TextBlock Text="FOCUS TIMER" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" 
                           Foreground="#888888" 
                           FontWeight="Bold" 
                           LetterSpacing="2"/>

                <Button HorizontalAlignment="Right" 
                        VerticalAlignment="Center" 
                        Content="✕" 
                        Click="CloseButton_Click"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        IsEnabled="{Binding ShowControls}"/>
            </Grid>

            <!-- Main Content Scaled -->
            <Viewbox Grid.Row="1" Stretch="Uniform" Margin="20" Classes="AnimFade" Opacity="{Binding CurrentTimerOpacity}" IsHitTestVisible="{Binding !IsSettingsVisible}">
                <StackPanel VerticalAlignment="Center" Spacing="25">
                    
                    <!-- Intent Setter -->
                    <TextBox Text="{Binding SessionGoal}" 
                             Watermark="What is your goal?"
                             IsVisible="{Binding !IsIntentLocked}"
                             HorizontalAlignment="Center"
                             TextAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             FontSize="14"
                             Width="240"/>
                             
                    <TextBlock Text="{Binding SessionGoal}"
                               IsVisible="{Binding IsIntentLocked}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{Binding ThemeGradientBrush}"
                               FontWeight="Bold"
                               FontSize="16"
                               TextWrapping="Wrap"
                               MaxWidth="240"/>

                    <!-- Timer Panel -->
                    <Button Background="Transparent" BorderThickness="0" Command="{Binding ToggleGhostModeCommand}" ToolTip.Tip="Click to toggle Ghost Mode" CornerRadius="150">
                        <Border Classes="TimerRing" CornerRadius="150" Width="240" Height="240" 
                                HorizontalAlignment="Center"
                                BorderBrush="{Binding ThemeGradientBrush}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="{Binding CurrentModeDisplay}" Foreground="{Binding ThemeGradientBrush}" FontWeight="Black" FontSize="14" LetterSpacing="4" HorizontalAlignment="Center" Margin="0,0,0,-5"/>
                                <TextBlock Text="{Binding TimeDisplay}"
                                           FontSize="65"
                                           FontWeight="Thin"
                                           LetterSpacing="2"
                                           HorizontalAlignment="Center"
                                           Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,10,0,0" IsVisible="{Binding IsNotGhostMode}">
                        <Button Content="START" 
                                Command="{Binding StartTimerCommand}"
                                IsVisible="{Binding !IsRunning}"
                                Width="90" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                CornerRadius="8"
                                Background="#00E5FF" Foreground="Black" FontWeight="Bold" LetterSpacing="1"/>
                        <Button Content="PAUSE" 
                                Command="{Binding StopTimerCommand}"
                                IsVisible="{Binding ShowPauseButton}"
                                Width="90" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                CornerRadius="8"
                                Background="#FF3366" Foreground="White" FontWeight="Bold" LetterSpacing="1"/>
                        <Button Content="RESET" 
                                Command="{Binding ResetTimerCommand}"
                                IsVisible="{Binding ShowControls}"
                                Width="90" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                CornerRadius="8"
                                Background="#333333" Foreground="White" FontWeight="SemiBold" LetterSpacing="1"/>
                    </StackPanel>
                </StackPanel>
            </Viewbox>

            <!-- Premium Settings Panel -->
            <Border Grid.Row="1" Grid.RowSpan="2" 
                    Classes="SettingsPanel" Classes.visible="{Binding IsSettingsVisible}"
                    Background="#E80A0A0A" 
                    CornerRadius="20"
                    Margin="10,0,10,10"
                    BorderBrush="#222222" BorderThickness="1">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <Border Grid.Row="0" Padding="0,20,0,10">
                        <TextBlock Text="SETTINGS" Foreground="White" FontWeight="Bold" FontSize="18" LetterSpacing="4" HorizontalAlignment="Center"/>
                    </Border>
                    
                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <StackPanel Spacing="25" Margin="20,10,20,80">
                            <!-- Timer Section -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="Timer Configuration" Foreground="{Binding ThemeGradientBrush}" FontWeight="Bold" FontSize="12" LetterSpacing="1"/>
                                
                                <Border Background="#141414" CornerRadius="12" Padding="15">
                                    <StackPanel Spacing="15">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Session Goal" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto,12,Auto,*,Auto">
                                                <Button Grid.Column="0" Content="-" Command="{Binding DecrementGoalHoursCommand}" Width="24" Height="24" CornerRadius="12" Background="#252525" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" FontSize="10"/>
                                                <TextBox Grid.Column="1" x:Name="GoalHoursTextBox" Name="GoalHoursTextBox" Text="{Binding GoalHoursString}" TextChanged="TextBox_TextChanged" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" Background="#1E1E1E" BorderThickness="0" CornerRadius="6" Padding="5,2,0,2" MinHeight="24" Margin="4,0">
                                                    <TextBox.InnerRightContent>
                                                        <TextBlock Text="hr" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="10" FontWeight="SemiBold"/>
                                                    </TextBox.InnerRightContent>
                                                </TextBox>
                                                <Button Grid.Column="2" Content="+" Command="{Binding IncrementGoalHoursCommand}" Width="24" Height="24" CornerRadius="12" Background="#252525" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" FontSize="10"/>
                                                <Button Grid.Column="4" Content="-" Command="{Binding DecrementGoalMinutesCommand}" Width="24" Height="24" CornerRadius="12" Background="#252525" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" FontSize="10"/>
                                                <TextBox Grid.Column="5" x:Name="GoalMinsTextBox" Name="GoalMinsTextBox" Text="{Binding GoalMinutesString}" TextChanged="TextBox_TextChanged" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" Background="#1E1E1E" BorderThickness="0" CornerRadius="6" Padding="5,2,0,2" MinHeight="24" Margin="4,0">
                                                    <TextBox.InnerRightContent>
                                                        <TextBlock Text="min" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="10" FontWeight="SemiBold"/>
                                                    </TextBox.InnerRightContent>
                                                </TextBox>
                                                <Button Grid.Column="6" Content="+" Command="{Binding IncrementGoalMinutesCommand}" Width="24" Height="24" CornerRadius="12" Background="#252525" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" FontSize="10"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Focus Interval" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto,12,Auto,*,Auto">
                                                <Button Grid.Column="0" Content="-" Command="{Binding DecrementFocusHoursCommand}" Width="24" Height="24" CornerRadius="12" Background="#252525" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" FontSize="10"/>
                                                <TextBox Grid.Column="1" x:Name="FocusHoursTextBox" Name="FocusHoursTextBox" Text="{Binding FocusHoursString}" TextChanged="TextBox_TextChanged" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" Background="#1E1E1E" BorderThickness="0" CornerRadius="6" Padding="5,2,0,2" MinHeight="24" Margin="4,0">
                                                    <TextBox.InnerRightContent>
                                                        <TextBlock Text="hr" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="10" FontWeight="SemiBold"/>
                                                    </TextBox.InnerRightContent>
                                                </TextBox>
                                                <Button Grid.Column="2" Content="+" Command="{Binding IncrementFocusHoursCommand}" Width="24" Height="24" CornerRadius="12" Background="#252525" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" FontSize="10"/>
                                                <Button Grid.Column="4" Content="-" Command="{Binding DecrementMinutesCommand}" Width="24" Height="24" CornerRadius="12" Background="#252525" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" FontSize="10"/>
                                                <TextBox Grid.Column="5" x:Name="CustomMinsTextBox" Name="CustomMinsTextBox" Text="{Binding CustomMinutesString}" TextChanged="TextBox_TextChanged" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" Background="#1E1E1E" BorderThickness="0" CornerRadius="6" Padding="5,2,0,2" MinHeight="24" Margin="4,0">
                                                    <TextBox.InnerRightContent>
                                                        <TextBlock Text="min" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="10" FontWeight="SemiBold"/>
                                                    </TextBox.InnerRightContent>
                                                </TextBox>
                                                <Button Grid.Column="6" Content="+" Command="{Binding IncrementMinutesCommand}" Width="24" Height="24" CornerRadius="12" Background="#252525" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" FontSize="10"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Break Interval" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                            <Grid ColumnDefinitions="Auto,*,Auto,12,Auto,*,Auto">
                                                <Button Grid.Column="0" Content="-" Command="{Binding DecrementBreakHoursCommand}" Width="24" Height="24" CornerRadius="12" Background="#252525" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" FontSize="10"/>
                                                <TextBox Grid.Column="1" x:Name="BreakHoursTextBox" Name="BreakHoursTextBox" Text="{Binding BreakHoursString}" TextChanged="TextBox_TextChanged" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" Background="#1E1E1E" BorderThickness="0" CornerRadius="6" Padding="5,2,0,2" MinHeight="24" Margin="4,0">
                                                    <TextBox.InnerRightContent>
                                                        <TextBlock Text="hr" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="10" FontWeight="SemiBold"/>
                                                    </TextBox.InnerRightContent>
                                                </TextBox>
                                                <Button Grid.Column="2" Content="+" Command="{Binding IncrementBreakHoursCommand}" Width="24" Height="24" CornerRadius="12" Background="#252525" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" FontSize="10"/>
                                                <Button Grid.Column="4" Content="-" Command="{Binding DecrementBreakMinutesCommand}" Width="24" Height="24" CornerRadius="12" Background="#252525" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" FontSize="10"/>
                                                <TextBox Grid.Column="5" x:Name="BreakMinsTextBox" Name="BreakMinsTextBox" Text="{Binding BreakMinutesString}" TextChanged="TextBox_TextChanged" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" Background="#1E1E1E" BorderThickness="0" CornerRadius="6" Padding="5,2,0,2" MinHeight="24" Margin="4,0">
                                                    <TextBox.InnerRightContent>
                                                        <TextBlock Text="min" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="10" FontWeight="SemiBold"/>
                                                    </TextBox.InnerRightContent>
                                                </TextBox>
                                                <Button Grid.Column="6" Content="+" Command="{Binding IncrementBreakMinutesCommand}" Width="24" Height="24" CornerRadius="12" Background="#252525" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" FontSize="10"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Blockers Section -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="Distraction Blockers" Foreground="{Binding ThemeGradientBrush}" FontWeight="Bold" FontSize="12" LetterSpacing="1"/>
                                
                                <Border Background="#141414" CornerRadius="12" Padding="15">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Blocked Apps (e.g. discord)" Foreground="#888888" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBox x:Name="BlockedAppsTextBox" Name="BlockedAppsTextBox"
                                                     Text="{Binding BlockedAppsString}" 
                                                     TextChanged="TextBox_TextChanged"
                                                     HorizontalAlignment="Stretch" Foreground="White"
                                                     CornerRadius="8" BorderThickness="0" Background="#1E1E1E"
                                                     FontSize="13" Padding="10"/>
                                        </StackPanel>
                                        
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Allowed Tab in Chrome (e.g. Figma)" Foreground="#888888" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBox x:Name="AllowedTabTextBox" Name="AllowedTabTextBox"
                                                     Text="{Binding AllowedTabString}" 
                                                     TextChanged="TextBox_TextChanged"
                                                     HorizontalAlignment="Stretch" Foreground="White"
                                                     CornerRadius="8" BorderThickness="0" Background="#1E1E1E"
                                                     FontSize="13" Padding="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Features Section -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="Advanced Features" Foreground="{Binding ThemeGradientBrush}" FontWeight="Bold" FontSize="12" LetterSpacing="1"/>
                                
                                <Border Background="#141414" CornerRadius="12" Padding="15">
                                    <StackPanel Spacing="15">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Auto-Start Cycles" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAutoStartEnabled}" OnContent="" OffContent="" Margin="0"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Mode Switch Sound" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsSoundEnabled}" OnContent="" OffContent="" Margin="0"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Ghost Mode" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsGhostModeEnabled}" OnContent="" OffContent="" Margin="0"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Iron Will" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsIronWillEnabled}" OnContent="" OffContent="" Margin="0"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Always On Top" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAlwaysOnTop}" OnContent="" OffContent="" Margin="0"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Background Opacity" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                            <Slider Grid.Column="1" Minimum="0.1" Maximum="1" Value="{Binding BackgroundOpacity}" Width="80" Margin="0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Ghost Opacity" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                            <Slider Grid.Column="1" Minimum="0.1" Maximum="1" Value="{Binding GhostOpacity}" Width="80" Margin="0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer / Floating Button -->
                    <Border Grid.Row="2" Padding="0,0,0,25">
                        <Border CornerRadius="20" BoxShadow="0 10 20 0 #40000000" HorizontalAlignment="Center">
                            <Button Content="✓ Done" 
                                    Command="{Binding ToggleSettingsCommand}"
                                    Background="#333333" Foreground="White" FontWeight="Bold" FontSize="14" LetterSpacing="1"
                                    CornerRadius="20" Padding="25,10"/>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- Stats Panel -->
            <Border Grid.Row="1" Grid.RowSpan="2" 
                    Classes="SettingsPanel" Classes.visible="{Binding IsStatsVisible}"
                    Background="#E80A0A0A" 
                    CornerRadius="20"
                    Margin="10,0,10,10"
                    BorderBrush="#222222" BorderThickness="1">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <Border Grid.Row="0" Padding="0,20,0,10">
                        <TextBlock Text="STATISTICS" Foreground="White" FontWeight="Bold" FontSize="18" LetterSpacing="4" HorizontalAlignment="Center"/>
                    </Border>
                    
                    <!-- Content -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <!-- Refined Chart -->
                        <Border Background="#111111" CornerRadius="15" Padding="20">
                            <StackPanel>
                                <TextBlock Text="ACTIVITY (7 DAYS)" Foreground="#888888" FontSize="10" FontWeight="Bold" HorizontalAlignment="Left" LetterSpacing="2" Margin="0,0,0,15"/>
                                
                                <Grid ColumnDefinitions="30,*" RowDefinitions="*,*,*" Height="90">
                                    <!-- Y Axis Labels -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ChartMaxLabel}" Foreground="#666666" FontSize="9" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ChartMidLabel}" Foreground="#666666" FontSize="9" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="0m" Foreground="#666666" FontSize="9" VerticalAlignment="Bottom"/>

                                    <!-- Horizontal Grid Lines -->
                                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="#222222" BorderThickness="0,1,0,0" VerticalAlignment="Top"/>
                                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#222222" BorderThickness="0,1,0,0" VerticalAlignment="Center"/>
                                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="#222222" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                                    <!-- Chart Canvas -->
                                    <Canvas Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="240" HorizontalAlignment="Left" Margin="10,0,0,0">
                                        <!-- Focus Line (Cyan) -->
                                        <Polyline Points="{Binding FocusChartPoints}" Stroke="#00E5FF" StrokeThickness="3" StrokeJoin="Round"/>
                                        <!-- Break Line (Purple) -->
                                        <Polyline Points="{Binding BreakChartPoints}" Stroke="#9D00FF" StrokeThickness="3" StrokeJoin="Round"/>
                                    </Canvas>
                                </Grid>
                                
                                <!-- X Axis Labels (Days) -->
                                <Canvas Width="240" Height="15" HorizontalAlignment="Left" Margin="40,5,0,0">
                                    <TextBlock Text="{Binding DayLabels[0]}" Foreground="#666666" FontSize="9" Canvas.Left="-10"/>
                                    <TextBlock Text="{Binding DayLabels[1]}" Foreground="#666666" FontSize="9" Canvas.Left="30"/>
                                    <TextBlock Text="{Binding DayLabels[2]}" Foreground="#666666" FontSize="9" Canvas.Left="70"/>
                                    <TextBlock Text="{Binding DayLabels[3]}" Foreground="#666666" FontSize="9" Canvas.Left="110"/>
                                    <TextBlock Text="{Binding DayLabels[4]}" Foreground="#666666" FontSize="9" Canvas.Left="150"/>
                                    <TextBlock Text="{Binding DayLabels[5]}" Foreground="#666666" FontSize="9" Canvas.Left="190"/>
                                    <TextBlock Text="{Binding DayLabels[6]}" Foreground="#666666" FontSize="9" Canvas.Left="230"/>
                                </Canvas>

                                <!-- Legend -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15" Margin="0,15,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Ellipse Width="8" Height="8" Fill="#00E5FF"/>
                                        <TextBlock Text="Focus" Foreground="#888888" FontSize="10" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Ellipse Width="8" Height="8" Fill="#9D00FF"/>
                                        <TextBlock Text="Break" Foreground="#888888" FontSize="10" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2x2 Metrics Grid -->
                        <Border Background="#111111" CornerRadius="15" Padding="20" Margin="0,15,0,0">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                                <!-- Focus -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,15">
                                    <TextBlock Text="Focus" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TodayFocusDisplay}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                                
                                <!-- Break -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,15">
                                    <TextBlock Text="Breaks" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TodayBreakDisplay}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Streak -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Streak" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding CurrentStreak}" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                        <TextBlock Text="Days" Foreground="#888888" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Break Ratio -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Break Ratio" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding BreakRatioDisplay}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Footer / Floating Button -->
                    <Border Grid.Row="2" Padding="0,0,0,25">
                        <Border CornerRadius="20" BoxShadow="0 10 20 0 #40000000" HorizontalAlignment="Center">
                            <Button Content="✓ Done" 
                                    Command="{Binding ToggleStatsCommand}"
                                    Background="#333333" Foreground="White" FontWeight="Bold" FontSize="14" LetterSpacing="1"
                                    CornerRadius="20" Padding="25,10"/>
                        </Border>
                    </Border>
                </Grid>
            </Border>            

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,0,0,20" IsVisible="{Binding IsNotGhostMode}">
                <Button Content="📊 Stats" 
                        Command="{Binding ToggleStatsCommand}"
                        IsVisible="{Binding ShowStatsButton}"
                        Background="Transparent"
                        Foreground="#888888"/>
                <Button Content="⚙ Settings" 
                        Command="{Binding ToggleSettingsCommand}"
                        IsVisible="{Binding ShowSettingsButton}"
                        Background="Transparent"
                        Foreground="#888888"/>
            </StackPanel>
        </Grid>
        
        <!-- Mini Mode UI -->
        <Grid IsVisible="{Binding IsMiniMode}" Background="Transparent">
            <!-- Back Button -->
            <Button HorizontalAlignment="Left" VerticalAlignment="Center" Content="↗" Command="{Binding ToggleMiniModeCommand}" Background="Transparent" Foreground="#888888" BorderThickness="0" Padding="10" IsVisible="{Binding IsNotGhostMode}"/>
            
            <!-- Center Content (Goal + Timer) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="15">
                <TextBlock Text="{Binding SessionGoal}" Foreground="{Binding ThemeGradientBrush}" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" MaxWidth="80" TextWrapping="Wrap" TextAlignment="Right" IsHitTestVisible="False"/>
                
                <Button Command="{Binding ToggleGhostModeCommand}" Background="Transparent" BorderThickness="0" Padding="0">
                    <TextBlock Text="{Binding TimeDisplay}" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
            
            <!-- Controls -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="5" Margin="0,0,10,0" IsVisible="{Binding IsNotGhostMode}">
                <Button Content="▶" Command="{Binding StartTimerCommand}" IsVisible="{Binding !IsRunning}" Background="Transparent" Foreground="#00E5FF" BorderThickness="0" Padding="5"/>
                <Button Content="⏸" Command="{Binding StopTimerCommand}" IsVisible="{Binding ShowPauseButton}" Background="Transparent" Foreground="#FF3366" BorderThickness="0" Padding="5"/>
            </StackPanel>
        </Grid>

        <!-- Goal Notification Overlay -->
        <Border IsVisible="{Binding IsGoalNotificationVisible}" Background="#E800E5FF" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="10,45,10,0" CornerRadius="12" Padding="15" BoxShadow="0 10 20 0 #40000000" IsHitTestVisible="{Binding IsGoalNotificationVisible}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Goal Reached! 🎉" Foreground="Black" FontWeight="Black" FontSize="16"/>
                    <TextBlock Text="You've completed your session goal for today!" Foreground="#222222" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissGoalNotificationCommand}" Background="#222222" Foreground="White" FontWeight="Bold" CornerRadius="8" Padding="15,8"/>
            </Grid>
        </Border>

        <!-- Resize Grip -->
        <Path Data="M 10,0 L 10,10 L 0,10 Z" 
              Fill="#888888" 
              Width="10" Height="10" 
              HorizontalAlignment="Right" 
              VerticalAlignment="Bottom" 
              Margin="5"
              Cursor="BottomRightCorner"
              PointerPressed="ResizeGrip_PointerPressed"
              IsVisible="{Binding ShowMainMode}" />
    </Grid>
</Window>
