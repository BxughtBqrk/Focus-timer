<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FocusTimer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="500"
        Width="{Binding WindowWidth}" Height="{Binding WindowHeight}"
        x:Class="FocusTimer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="FocusTimer"
        Topmost="{Binding IsAlwaysOnTop}"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        MinWidth="180" MinHeight="80"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Classes.Ghost="{Binding IsGhostModeEnabled}"
        PointerPressed="Window_PointerPressed">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid Classes.Ghost="{Binding IsGhostModeEnabled}">
        <Grid.Styles>
            <Style Selector="Border.TimerRing">
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="#1E1E1E" Opacity="0.5"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style Selector="Border.AnimFade">
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                    </Transitions>
                </Setter>
            </Style>

            <Style Selector="Viewbox.AnimFade">
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                    </Transitions>
                </Setter>
            </Style>

            <Style Selector="Border.SettingsPanel">
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="RenderTransform" Value="translateY(20px)"/>
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                    </Transitions>
                </Setter>
            </Style>

            <Style Selector="Border.SettingsPanel.visible">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="IsHitTestVisible" Value="True"/>
                <Setter Property="RenderTransform" Value="translateY(0px)"/>
            </Style>
        </Grid.Styles>

        <!-- Main Dark Background -->
        <Border Classes="AnimFade" Background="#121212" Opacity="{Binding CurrentBackgroundOpacity}" IsHitTestVisible="{Binding IsNotGhostMode}"/>

        <!-- Main UI -->
        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding ShowMainMode}">
            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Height="40" Background="Transparent" Margin="10,0" IsVisible="{Binding IsNotGhostMode}">
                <Button HorizontalAlignment="Left" 
                        VerticalAlignment="Center" 
                        Content="↙" 
                        Command="{Binding ToggleMiniModeCommand}"
                        Background="Transparent"
                        Foreground="#888888"
                        BorderThickness="0"
                        FontSize="16"
                        IsEnabled="{Binding ShowControls}"/>

                <TextBlock Text="FOCUS TIMER" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" 
                           Foreground="#888888" 
                           FontWeight="Bold" 
                           LetterSpacing="2"/>

                <Button HorizontalAlignment="Right" 
                        VerticalAlignment="Center" 
                        Content="✕" 
                        Click="CloseButton_Click"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        IsEnabled="{Binding ShowControls}"/>
            </Grid>

            <!-- Main Content Scaled -->
            <Viewbox Grid.Row="1" Stretch="Uniform" Margin="20" Classes="AnimFade" Opacity="{Binding CurrentTimerOpacity}" IsHitTestVisible="{Binding !IsSettingsVisible}">
                <StackPanel VerticalAlignment="Center" Spacing="25">
                    
                    <!-- Intent Setter -->
                    <TextBox Text="{Binding SessionGoal}" 
                             Watermark="What is your goal?"
                             IsVisible="{Binding !IsIntentLocked}"
                             HorizontalAlignment="Center"
                             TextAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             FontSize="14"
                             Width="240"/>
                             
                    <TextBlock Text="{Binding SessionGoal}"
                               IsVisible="{Binding IsIntentLocked}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{Binding ThemeGradientBrush}"
                               FontWeight="Bold"
                               FontSize="16"
                               TextWrapping="Wrap"
                               MaxWidth="240"/>

                    <!-- Timer Panel -->
                    <Button Background="Transparent" BorderThickness="0" Command="{Binding ToggleGhostModeCommand}" ToolTip.Tip="Click to toggle Ghost Mode" CornerRadius="150">
                        <Border Classes="TimerRing" CornerRadius="150" Width="240" Height="240" 
                                HorizontalAlignment="Center"
                                BorderBrush="{Binding ThemeGradientBrush}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="{Binding CurrentModeDisplay}" Foreground="{Binding ThemeGradientBrush}" FontWeight="Black" FontSize="14" LetterSpacing="4" HorizontalAlignment="Center" Margin="0,0,0,-5"/>
                                <TextBlock Text="{Binding TimeDisplay}"
                                           FontSize="65"
                                           FontWeight="Thin"
                                           LetterSpacing="2"
                                           HorizontalAlignment="Center"
                                           Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,10,0,0" IsVisible="{Binding IsNotGhostMode}">
                        <Button Content="START" 
                                Command="{Binding StartTimerCommand}"
                                IsVisible="{Binding !IsRunning}"
                                Width="90" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                CornerRadius="8"
                                Background="#00E5FF" Foreground="Black" FontWeight="Bold" LetterSpacing="1"/>
                        <Button Content="PAUSE" 
                                Command="{Binding StopTimerCommand}"
                                IsVisible="{Binding ShowPauseButton}"
                                Width="90" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                CornerRadius="8"
                                Background="#FF3366" Foreground="White" FontWeight="Bold" LetterSpacing="1"/>
                        <Button Content="RESET" 
                                Command="{Binding ResetTimerCommand}"
                                IsVisible="{Binding ShowControls}"
                                Width="90" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                CornerRadius="8"
                                Background="#333333" Foreground="White" FontWeight="SemiBold" LetterSpacing="1"/>
                    </StackPanel>
                </StackPanel>
            </Viewbox>

            <!-- Premium Settings Panel -->
            <Border Grid.Row="1" Grid.RowSpan="2" 
                    Classes="SettingsPanel" Classes.visible="{Binding IsSettingsVisible}"
                    Background="#E80A0A0A" 
                    CornerRadius="20"
                    Margin="10,0,10,10"
                    BorderBrush="#222222" BorderThickness="1">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <Border Grid.Row="0" Padding="0,20,0,10">
                        <TextBlock Text="SETTINGS" Foreground="White" FontWeight="Bold" FontSize="18" LetterSpacing="4" HorizontalAlignment="Center"/>
                    </Border>
                    
                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <StackPanel Spacing="25" Margin="20,10,20,80">
                            <!-- Timer Section -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="Timer Configuration" Foreground="{Binding ThemeGradientBrush}" FontWeight="Bold" FontSize="12" LetterSpacing="1"/>
                                
                                <Border Background="#141414" CornerRadius="12" Padding="15">
                                    <StackPanel Spacing="15">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Focus Duration (Min)" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                            
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Button Content="-" Command="{Binding DecrementMinutesCommand}" Width="28" Height="28" CornerRadius="14" Background="#252525" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                                                <TextBox Text="{Binding CustomMinutesString}" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Width="45" TextAlignment="Center" Background="#1E1E1E" BorderThickness="0" CornerRadius="6" Padding="5,4" MinHeight="28"/>
                                                <Button Content="+" Command="{Binding IncrementMinutesCommand}" Width="28" Height="28" CornerRadius="14" Background="#252525" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Break Duration (Min)" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                            
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Button Content="-" Command="{Binding DecrementBreakMinutesCommand}" Width="28" Height="28" CornerRadius="14" Background="#252525" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                                                <TextBlock Text="{Binding BreakMinutes}" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Width="45" TextAlignment="Center" Background="#1E1E1E" Padding="0,4" MinHeight="28"/>
                                                <Button Content="+" Command="{Binding IncrementBreakMinutesCommand}" Width="28" Height="28" CornerRadius="14" Background="#252525" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Blockers Section -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="Distraction Blockers" Foreground="{Binding ThemeGradientBrush}" FontWeight="Bold" FontSize="12" LetterSpacing="1"/>
                                
                                <Border Background="#141414" CornerRadius="12" Padding="15">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Blocked Apps (e.g. discord)" Foreground="#888888" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding BlockedAppsString}" 
                                                     HorizontalAlignment="Stretch" Foreground="White"
                                                     CornerRadius="8" BorderThickness="0" Background="#1E1E1E"
                                                     FontSize="13" Padding="10"/>
                                        </StackPanel>
                                        
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Allowed Tab (e.g. Figma)" Foreground="#888888" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding AllowedTabString}" 
                                                     HorizontalAlignment="Stretch" Foreground="White"
                                                     CornerRadius="8" BorderThickness="0" Background="#1E1E1E"
                                                     FontSize="13" Padding="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Features Section -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="Advanced Features" Foreground="{Binding ThemeGradientBrush}" FontWeight="Bold" FontSize="12" LetterSpacing="1"/>
                                
                                <Border Background="#141414" CornerRadius="12" Padding="15">
                                    <StackPanel Spacing="15">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Ghost Mode" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsGhostModeEnabled}" OnContent="" OffContent="" Margin="0"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Iron Will" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsIronWillEnabled}" OnContent="" OffContent="" Margin="0"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Always On Top" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAlwaysOnTop}" OnContent="" OffContent="" Margin="0"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Background Opacity" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                            <Slider Grid.Column="1" Minimum="0.1" Maximum="1" Value="{Binding BackgroundOpacity}" Width="80" Margin="0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Ghost Opacity" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                                            <Slider Grid.Column="1" Minimum="0.1" Maximum="1" Value="{Binding GhostOpacity}" Width="80" Margin="0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer / Floating Button -->
                    <Border Grid.Row="2" Padding="0,0,0,25">
                        <Border CornerRadius="20" BoxShadow="0 10 20 0 #40000000" HorizontalAlignment="Center">
                            <Button Content="✓ Done" 
                                    Command="{Binding ToggleSettingsCommand}"
                                    Background="#333333" Foreground="White" FontWeight="Bold" FontSize="14" LetterSpacing="1"
                                    CornerRadius="20" Padding="25,10"/>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- Stats Panel -->
            <Border Grid.Row="1" Grid.RowSpan="2" 
                    Classes="SettingsPanel" Classes.visible="{Binding IsStatsVisible}"
                    Background="#E80A0A0A" 
                    CornerRadius="20"
                    Margin="10,0,10,10"
                    BorderBrush="#222222" BorderThickness="1">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <Border Grid.Row="0" Padding="0,20,0,10">
                        <TextBlock Text="STATISTICS" Foreground="White" FontWeight="Bold" FontSize="18" LetterSpacing="4" HorizontalAlignment="Center"/>
                    </Border>
                    
                    <!-- Content -->
                    <StackPanel Grid.Row="1" Spacing="20" Margin="20,20,20,80" VerticalAlignment="Center">
                        
                        <!-- Today Focus -->
                        <Border Background="#141414" CornerRadius="15" Padding="20">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="TODAY'S FOCUS" Foreground="#888888" FontSize="12" FontWeight="Bold" LetterSpacing="2" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TodayFocusDisplay}" Foreground="{Binding ThemeGradientBrush}" FontSize="36" FontWeight="Black" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Current Streak -->
                        <Border Background="#141414" CornerRadius="15" Padding="20">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="CURRENT STREAK" Foreground="#888888" FontSize="12" FontWeight="Bold" LetterSpacing="2" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentStreak}" Foreground="White" FontSize="36" FontWeight="Black" VerticalAlignment="Center"/>
                                    <TextBlock Text="DAYS 🔥" Foreground="#FF5500" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                    </StackPanel>

                    <!-- Footer / Floating Button -->
                    <Border Grid.Row="2" Padding="0,0,0,25">
                        <Border CornerRadius="20" BoxShadow="0 10 20 0 #40000000" HorizontalAlignment="Center">
                            <Button Content="✓ Done" 
                                    Command="{Binding ToggleStatsCommand}"
                                    Background="#333333" Foreground="White" FontWeight="Bold" FontSize="14" LetterSpacing="1"
                                    CornerRadius="20" Padding="25,10"/>
                        </Border>
                    </Border>
                </Grid>
            </Border>            

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,0,0,20" IsVisible="{Binding IsNotGhostMode}">
                <Button Content="📊 Stats" 
                        Command="{Binding ToggleStatsCommand}"
                        IsVisible="{Binding ShowStatsButton}"
                        Background="Transparent"
                        Foreground="#888888"/>
                <Button Content="⚙ Settings" 
                        Command="{Binding ToggleSettingsCommand}"
                        IsVisible="{Binding ShowSettingsButton}"
                        Background="Transparent"
                        Foreground="#888888"/>
            </StackPanel>
        </Grid>
        
        <!-- Mini Mode UI -->
        <Grid IsVisible="{Binding IsMiniMode}" Background="Transparent" ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0" Content="↗" Command="{Binding ToggleMiniModeCommand}" Background="Transparent" Foreground="#888888" BorderThickness="0" Padding="10" IsVisible="{Binding IsNotGhostMode}"/>
            
            <TextBlock Grid.Column="1" Text="{Binding SessionGoal}" Foreground="{Binding ThemeGradientBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="11" FontWeight="Bold" MaxWidth="60" TextWrapping="Wrap" IsHitTestVisible="False"/>
            
            <Button Grid.Column="2" Command="{Binding ToggleGhostModeCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="10,0">
                <TextBlock Text="{Binding TimeDisplay}" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Button>
            
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" Margin="0,0,10,0" IsVisible="{Binding IsNotGhostMode}">
                <Button Content="▶" Command="{Binding StartTimerCommand}" IsVisible="{Binding !IsRunning}" Background="Transparent" Foreground="#00E5FF" BorderThickness="0" Padding="5"/>
                <Button Content="⏸" Command="{Binding StopTimerCommand}" IsVisible="{Binding IsRunning}" Background="Transparent" Foreground="#FF3366" BorderThickness="0" Padding="5"/>
            </StackPanel>
        </Grid>

        <!-- Resize Grip -->
        <Path Data="M 10,0 L 10,10 L 0,10 Z" 
              Fill="#888888" 
              Width="10" Height="10" 
              HorizontalAlignment="Right" 
              VerticalAlignment="Bottom" 
              Margin="5"
              Cursor="BottomRightCorner"
              PointerPressed="ResizeGrip_PointerPressed"
              IsVisible="{Binding ShowMainMode}" />
    </Grid>
</Window>
